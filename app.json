{
  "expo": {
    "name": "JBH International Limited",
    "slug": "j-business-house",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jbusinesshouse",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "userInterfaceStyle": "light",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/foreground-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jbh.internationallimited",
      "versionCode": 6
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "imageWidth": 200,
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-system-ui",
        {
          "parentTheme": "Light"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to create an account and uploading products."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/foreground-icon.png",
          "color": "#f5832b",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProperties": {
              "MYAPP_UPLOAD_STORE_FILE": "upload-keystore.jks"
            }
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c24f9ee5-c2bd-4c72-ac16-b9a3c995a78c"
      }
    },
    "owner": "tajbirhossain"
  }
}
